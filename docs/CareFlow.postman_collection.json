{
  "info": {
    "name": "CareFlow \u00b7 authenticated evaluation",
    "description": "Run in order against Development. Cookie jar must be enabled. CRUD evaluation creates and deletes one synthetic patient. Use Swagger for all other entity schemas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5080"
    },
    {
      "key": "csrf",
      "value": ""
    },
    {
      "key": "patientId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 \u00b7 Get anonymous CSRF token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/csrf"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request succeeded\", () => pm.expect(pm.response.code).to.be.within(200,299));",
              "pm.collectionVariables.set(\"csrf\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2 \u00b7 Admin login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrf}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@careflow.local\",\n  \"password\": \"CareFlow@Demo2026!\",\n  \"role\": \"Admin\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request succeeded\", () => pm.expect(pm.response.code).to.be.within(200,299));"
            ]
          }
        }
      ]
    },
    {
      "name": "3 \u00b7 Refresh authenticated CSRF token",
      "request": {
        "method": "GET",
        "header": [
          {
